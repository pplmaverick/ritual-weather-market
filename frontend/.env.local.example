# Deployed WeatherMarket contract address (from forge script output)
NEXT_PUBLIC_MARKET_ADDRESS=0xYOUR_DEPLOYED_CONTRACT_ADDRESS

# WalletConnect project ID (get one free at https://cloud.walletconnect.com)
NEXT_PUBLIC_WC_PROJECT_ID=your_walletconnect_project_id

# Ritual RPC (proxied through Next.js API route for CORS)
RITUAL_RPC_URL=https://rpc.ritualfoundation.org
